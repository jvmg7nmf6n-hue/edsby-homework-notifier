{
  "name": "edsby-homework-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial personal automation: scrapes the Edsby parent portal daily and pushes homework notifications via ntfy.sh.",
  "type": "module",
  "scripts": {
    "check": "node scripts/run.js",
    "check:dry": "node scripts/run.js --dry-run",
    "backfill": "node scripts/backfill.js",
    "gmail:connect": "node --env-file=.env scripts/gmailAuthorize.js",
    "migrate:state": "node --env-file=.env scripts/migrateLegacyState.js",
    "test": "node --test",
    "lint": "node scripts/validate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
