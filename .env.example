# Copy to .env for local testing only (never commit .env -- it's gitignored).
# In GitHub Actions, these same names are set as encrypted repo Secrets
# instead (Settings -> Secrets and variables -> Actions) -- see README.

EDSBY_EMAIL=
EDSBY_PASSWORD=

# Pick a long, hard-to-guess topic name -- anyone who knows it can read the
# feed on ntfy.sh, so treat it like a password even though ntfy itself
# doesn't require authentication. e.g. a random string like
# "bin-salman-hw-9f2a7c1e4b".
NTFY_TOPIC=

# Optional. Defaults to https://ntfy.sh if unset -- only set this if you're
# self-hosting an ntfy server.
NTFY_SERVER=

# Optional. Failure alerts go here instead of NTFY_TOPIC if set -- useful to
# keep "the homework feed" and "something broke" as separate subscriptions.
NTFY_ALERTS_TOPIC=

# Set to "true" to print the ntfy payload instead of sending it (the real
# Edsby login/scrape still runs for real -- see README's Testing section).
DRY_RUN=false
