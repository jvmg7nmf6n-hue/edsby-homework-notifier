# Copy to .env for local use. Never commit .env or paste secret values into logs.

EDSBY_ENABLED=true
EDSBY_BASE_URL=
EDSBY_PARENT_HOME_URL=
EDSBY_EMAIL=
EDSBY_PASSWORD=
# Preferred in GitHub: one encrypted secret containing baseUrl,
# parentHomeUrl, and children. The separate variables below remain supported.
EDSBY_CONFIG_JSON={"baseUrl":"https://your-school.edsby.com","parentHomeUrl":"https://your-school.edsby.com/...","children":[{"id":"child-id","name":"Child name","grade":"Grade","dashboardUrl":"https://your-school.edsby.com/..."}]}
EDSBY_CHILDREN_JSON=[{"id":"child-id","name":"Child name","grade":"Grade","dashboardUrl":"https://your-school.edsby.com/..."}]

# Optional Gmail read-only source. The account address is checked so an OAuth
# token for the wrong Google account cannot be used accidentally.
GMAIL_ENABLED=false
GMAIL_ACCOUNT_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY={from:(school.example) from:(school.edsby.com)}
GMAIL_SCHOOL_DOMAINS=school.example,school.edsby.com
GMAIL_CHILD_ID=child-id
GMAIL_MAX_MESSAGES=25

# Private enrichment directory; keep real teacher names in GitHub Secrets.
SCHOOL_COURSES_JSON=[{"course":"7-K Mathematics","teacher":"Teacher name","keywords":["linear equations"]}]
RUN_MODE=digest

# Use a unique passphrase of at least 20 characters. It encrypts repository
# state and unlocks the browser dashboard; do not reuse a Gmail/Edsby password.
DATA_ENCRYPTION_KEY=

NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_ALERTS_TOPIC=
DRY_RUN=false
SAVE_DIAGNOSTICS=false
